# Prevent PHP execution in uploads directory

<FilesMatch "\.(php|phtml|php3|php4|php5|phps|phtm)$">
    Order Deny,Allow
    Deny from all
</FilesMatch>

# Disable script execution

php_flag engine off
Options -ExecCGI
AddHandler cgi-script .php .phtml .php3 .php4 .php5
RemoveHandler .php .phtml .php3 .php4 .php5
